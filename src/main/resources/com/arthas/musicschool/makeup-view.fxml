<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.arthas.musicschool.controller.MakeupController"
      spacing="0" stylesheets="@styles.css">

    <!-- Toolbar -->
    <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <Label text="Reposições" styleClass="app-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Atualizar" onAction="#onRefresh" styleClass="btn-secondary"/>
    </HBox>

    <!-- Seção 1: Alunos com reposição pendente -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT" spacing="8">
        <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
        <Label text="Alunos com reposição pendente" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
    </HBox>

    <TableView fx:id="studentTable" VBox.vgrow="SOMETIMES" prefHeight="200" tableMenuButtonVisible="true">
        <columns>
            <TableColumn fx:id="colName"       text="Nome"            prefWidth="200" minWidth="120"/>
            <TableColumn fx:id="colInstrument" text="Instrumento"     prefWidth="130" minWidth="80"/>
            <TableColumn fx:id="colTeacher"    text="Professor"       prefWidth="150" minWidth="90"/>
            <TableColumn fx:id="colSlot"       text="Dia / Horário"   prefWidth="140" minWidth="100"/>
            <TableColumn fx:id="colPending"    text="Reposições"      prefWidth="120" minWidth="90"/>
        </columns>
        <placeholder>
            <Label text="Nenhum aluno com reposição pendente."/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox styleClass="action-bar" spacing="8" alignment="CENTER_LEFT">
        <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
        <Button text="Agendar Reposição" onAction="#onSchedule" styleClass="btn-lesson"/>
        <Button text="Zerar Contador"    onAction="#onZero"     styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" text="0 pendentes" styleClass="count-label"/>
    </HBox>

    <Separator/>

    <!-- Seção 2: Reposições agendadas -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT" spacing="8">
        <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
        <Label text="Reposições agendadas" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
    </HBox>

    <TableView fx:id="makeupTable" VBox.vgrow="ALWAYS" tableMenuButtonVisible="true">
        <columns>
            <TableColumn fx:id="mColName"       text="Aluno"           prefWidth="200" minWidth="120"/>
            <TableColumn fx:id="mColInstrument" text="Instrumento"     prefWidth="120" minWidth="80"/>
            <TableColumn fx:id="mColSlot"       text="Dia / Horário"   prefWidth="140" minWidth="100"/>
            <TableColumn fx:id="mColDate"       text="Data Agendada"   prefWidth="130" minWidth="90"/>
            <TableColumn fx:id="mColNotes"      text="Observações"     prefWidth="200" minWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Nenhuma reposição agendada."/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox styleClass="action-bar" spacing="8" alignment="CENTER_LEFT">
        <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
        <Button text="Confirmar Presença" onAction="#onConfirmPresence" styleClass="btn-makeup"/>
        <Button text="Cancelar Reposição" onAction="#onDeleteMakeup"   styleClass="btn-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="makeupCountLabel" text="0 agendadas" styleClass="count-label"/>
    </HBox>

</VBox>
