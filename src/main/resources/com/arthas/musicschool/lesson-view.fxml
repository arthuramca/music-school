<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.arthas.musicschool.controller.LessonController"
            stylesheets="@styles.css">
    <top>
        <VBox spacing="6">
            <padding><Insets top="14" right="16" bottom="10" left="16"/></padding>
            <Label fx:id="studentNameLabel" styleClass="app-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="+ Registrar Aula" onAction="#onRegisterLesson" styleClass="btn-primary"/>
                <Button text="Excluir"           onAction="#onDeleteLesson"  styleClass="btn-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="attendanceLabel" styleClass="count-label"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="lessonTable">
            <columns>
                <TableColumn fx:id="colDate"     text="Data"       prefWidth="130"/>
                <TableColumn fx:id="colAttended" text="Presença"   prefWidth="120"/>
                <TableColumn fx:id="colNotes"    text="Observações" prefWidth="300"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
