<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.arthas.musicschool.controller.MainController"
            styleClass="main-pane"
            stylesheets="@styles.css">
    <top>
        <VBox>
            <!-- Barra superior: logo + busca -->
            <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                <Label text="🎵 Music School" styleClass="app-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Buscar por nome, instrumento, professor..."
                           prefWidth="300" onAction="#onSearch"/>
                <Button text="Buscar"  onAction="#onSearch"       styleClass="btn-secondary"/>
                <Button text="Limpar"  onAction="#onClearSearch"  styleClass="btn-secondary"/>
                <Separator orientation="VERTICAL"/>
                <Button text="⛶" onAction="#onToggleFullscreen" styleClass="btn-secondary" prefWidth="32">
                    <tooltip><Tooltip text="Tela cheia (F11)"/></tooltip>
                </Button>
            </HBox>

            <!-- MenuBar principal -->
            <MenuBar fx:id="appMenuBar" styleClass="app-menu-bar">
                <menus>
                    <Menu text="Alunos">
                        <items>
                            <MenuItem text="+ Novo Aluno"   onAction="#onNewStudent"/>
                            <MenuItem text="Editar"         onAction="#onEditStudent"/>
                            <MenuItem text="Excluir"        onAction="#onDeleteStudent"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Pagamentos"     onAction="#onPayments"/>
                            <MenuItem text="Aulas"          onAction="#onLessons"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Deduplicar"     onAction="#onDeduplicate"/>
                        </items>
                    </Menu>
                    <Menu text="Agenda">
                        <items>
                            <MenuItem text="Agenda Semanal" onAction="#onAgenda"/>
                            <MenuItem text="Reposições"     onAction="#onMakeup"/>
                            <MenuItem text="Fila de Espera" onAction="#onWaitlist"/>
                        </items>
                    </Menu>
                    <Menu text="Relatórios">
                        <items>
                            <MenuItem text="Gráficos"       onAction="#onCharts"/>
                            <MenuItem text="Gerar PDF"      onAction="#onGeneratePdf"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Exportar .xlsx" onAction="#onExport"/>
                            <MenuItem text="Importar .xlsx" onAction="#onImport"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Backup"         onAction="#onBackup"/>
                        </items>
                    </Menu>
                    <Menu text="Configurações">
                        <items>
                            <MenuItem text="Alterar Acesso" onAction="#onChangePassword"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- Barra de filtros -->
            <HBox styleClass="filter-bar" spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
                <Label text="Instrumento:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <ComboBox fx:id="instrumentFilter" prefWidth="150"/>
                <Label text="Status:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <ComboBox fx:id="statusFilter" prefWidth="120"/>
            </HBox>

            <Separator/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="studentTable" tableMenuButtonVisible="true">
            <columns>
                <TableColumn fx:id="colPhoto"      text="Foto"        prefWidth="50"  minWidth="44"/>
                <TableColumn fx:id="colName"       text="Nome"        prefWidth="200" minWidth="120"/>
                <TableColumn fx:id="colInstrument" text="Instrumento" prefWidth="130" minWidth="80"/>
                <TableColumn fx:id="colLevel"      text="Nível"       prefWidth="110" minWidth="80"/>
                <TableColumn fx:id="colTeacher"    text="Professor"   prefWidth="150" minWidth="90"/>
                <TableColumn fx:id="colStatus"     text="Status"      prefWidth="90"  minWidth="70"/>
                <TableColumn fx:id="colFee"        text="Mensalidade" prefWidth="110" minWidth="80"/>
            </columns>
            <placeholder>
                <Label text="Nenhum aluno cadastrado. Use Alunos › + Novo Aluno para começar."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="5" right="16" bottom="5" left="16"/></padding>
            <Label fx:id="statusLabel" text="Pronto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="0 alunos" styleClass="count-label"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="clockLabel" text="--/--/----  --:--:--"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </HBox>
    </bottom>
</BorderPane>
