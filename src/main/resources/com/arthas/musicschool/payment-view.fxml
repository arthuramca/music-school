<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.arthas.musicschool.controller.PaymentController"
            stylesheets="@styles.css">
    <top>
        <VBox spacing="6">
            <padding><Insets top="14" right="16" bottom="10" left="16"/></padding>
            <Label fx:id="studentNameLabel" styleClass="app-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="✔ Registrar Pagamento" onAction="#onMarkPaid"      styleClass="btn-success"/>
                <Button text="↻ Gerar Meses Pendentes" onAction="#onGenerateMonths" styleClass="btn-secondary"/>
                <Button text="Excluir"                onAction="#onDelete"        styleClass="btn-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="summaryLabel" styleClass="count-label"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="paymentTable">
            <columns>
                <TableColumn fx:id="colMonth"    text="Mês/Ano"   prefWidth="110"/>
                <TableColumn fx:id="colAmount"   text="Valor"     prefWidth="110"/>
                <TableColumn fx:id="colStatus"   text="Status"    prefWidth="110"/>
                <TableColumn fx:id="colPaidDate" text="Data Pag." prefWidth="120"/>
                <TableColumn fx:id="colNotes"    text="Obs."      prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
